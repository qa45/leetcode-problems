{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: build current problem",
            "type": "process",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wconversion",
                "-Wshadow",
                "-g3",
                "-O0",
                "-I",
                "${workspaceFolder}\\test",
                "${fileDirname}\\test.c",
                "-o",
                "${fileDirname}\\test.exe"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;C:\\Windows\\System32;C:\\Windows"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build test.c in the active problem directory with GCC (C17)."
        },
        {
            "label": "C: run current problem",
            "type": "process",
            "command": "${fileDirname}\\test.exe",
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;C:\\Windows\\System32;C:\\Windows"
                }
            },
            "dependsOrder": "sequence",
            "dependsOn": "C: build current problem",
            "problemMatcher": []
        }
    ]
}
